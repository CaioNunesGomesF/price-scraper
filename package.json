{
  "name": "price-scraper-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "price-scraper-api",
    "price-scraper-web"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w price-scraper-api\" \"npm run dev -w price-scraper-web\"",
    "dev:api": "npm run dev -w price-scraper-api",
    "dev:web": "npm run dev -w price-scraper-web",
    "build": "npm run build -w price-scraper-web"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
